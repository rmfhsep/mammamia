// MongoDB + Prisma 6.x (Prisma 7 dropped MongoDB support — see mammamia/backend/.agents/skills/prisma-mongodb-upgrade)
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SourceType {
  DOMESTIC
  FOREIGN
}

enum ArticleCategory {
  AI
  DEV
  DATA
}

model Article {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  sourceId    String // data/sources.ts의 SourceConfig.id
  sourceName  String // 화면에 표시할 매체명 ("요즘IT", "OpenAI" 등)
  sourceType  SourceType
  category    ArticleCategory
  title       String // 국내: RSS 원문 제목 그대로 / 해외: Claude가 사실관계만 보고 새로 쓴 한국어 제목
  summary     String // 국내: RSS 공식 요약 그대로 / 해외: Claude가 새로 쓴 한국어 요약(번역 아님)
  originalUrl String          @unique // 중복 수집 방지 기준. 탭하면 이 주소로 이동한다
  publishedAt DateTime
  createdAt   DateTime        @default(now())

  @@index([publishedAt])
  @@index([category])
}
